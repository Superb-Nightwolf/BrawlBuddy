{$BRAWLBUDDY_API_HOST} {
    encode zstd gzip
    request_body {
        max_size 64KB
    }
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }
    @privateDocs path /docs /docs/* /redoc /openapi.json
    respond @privateDocs 404
    reverse_proxy api:8000
}
